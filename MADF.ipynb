# 5. Enhanced Baseline Methods + SOTA Comparisons
# ================================
def baseline_gaussian(image, ksize=5, sigma=0):
    if image is None or image.size == 0:
        return image
    ksize = int(ksize) if int(ksize) % 2 == 1 else int(ksize) + 1
    return cv2.GaussianBlur(image, (ksize, ksize), sigmaX=sigma)

def baseline_median(image, ksize=5):
    if image is None or image.size == 0:
        return image
    ksize = int(ksize) if int(ksize) % 2 == 1 else int(ksize) + 1
    return cv2.medianBlur(image, ksize)

def baseline_bilateral(image, d=9, sigmaColor=75, sigmaSpace=75):
    if image is None or image.size == 0:
        return image
    return cv2.bilateralFilter(image, d, sigmaColor, sigmaSpace)

# BM3D simulation (simplified version)
def baseline_bm3d_simulated(image):
    """Simplified BM3D-like filtering for comparison"""
    if image is None or image.size == 0:
        return image
    # Use an advanced bilateral filter as approximation
    return cv2.bilateralFilter(image, 15, 50, 50)

# Non-local means for comparison
def baseline_nlm(image):
    if image is None or image.size == 0:
        return image
    return cv2.fastNlMeansDenoisingColored(image, None, 10, 10, 7, 21)

# Existing hybrids
def adaptive_kalman_nlm_denoise(image):
    """Novel Hybrid: Adaptive Kalman + NLM for medical, optimized simply"""
    if image is None or image.size == 0:
        return image
    
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY).astype(np.float32)
    h, w = gray.shape
    
    # Simple adaptive Kalman simulation (1D for rows)
    for i in range(h):
        # Predict
        if i == 0:
            x_pred = gray[i]
            p_pred = 1.0
        else:
            x_pred = gray[i-1]
            p_pred = p_pred + 1.0  # Q=1
        
        # Update (simplified R=25)
        z = gray[i]
        k = p_pred / (p_pred + 25)
        x_update = x_pred + k * (z - x_pred)
        p_update = (1 - k) * p_pred
        gray[i] = x_update
    
    # NLM on gray
    gray_denoised = cv2.fastNlMeansDenoising(gray.astype(np.uint8), None, 10, 7, 21)
    
    # Back to color (simple)
    denoised = cv2.cvtColor(gray_denoised, cv2.COLOR_GRAY2BGR)
    return denoised

# NEW: Retinex-NLM
