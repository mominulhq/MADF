    ("NLM", lambda x: baseline_nlm(x)),
    ("BM3D_Sim", lambda x: baseline_bm3d_simulated(x)),
    ("Kalman-NLM Hybrid", lambda x: adaptive_kalman_nlm_denoise(x)),
