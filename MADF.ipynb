def calculate_vessel_metrics(original_gray, enhanced_gray, vessel_gt=None):
    """
    Novel: Vessel sensitivity/specificity if GT available; else approximate vesselness
    - For real-world: Aids in justifying telemedicine applications
    """
    if original_gray is None or enhanced_gray is None:
        return {'Vessel_Sensitivity': 0.0, 'Vessel_Specificity': 0.0}
    
    # Frangi as proxy for vessels if no GT
    orig_vesselness = frangi(original_gray / 255.0)
    enh_vesselness = frangi(enhanced_gray / 255.0)
    
    # Threshold for binary
    thresh = 0.5
    orig_vessels = (orig_vesselness > thresh).astype(int)
    enh_vessels = (enh_vesselness > thresh).astype(int)
    
    if vessel_gt is not None:
        tp = np.sum((enh_vessels == 1) & (vessel_gt == 1))
        fp = np.sum((enh_vessels == 1) & (vessel_gt == 0))
        fn = np.sum((enh_vessels == 0) & (vessel_gt == 1))
        tn = np.sum((enh_vessels == 0) & (vessel_gt == 0))
        sensitivity = tp / (tp + fn) if (tp + fn) > 0 else 0
        specificity = tn / (tn + fp) if (tn + fp) > 0 else 0
    else:
        # Approximate: Ratio of preserved high-vesselness pixels
        preserved = np.sum((orig_vesselness > np.mean(orig_vesselness)) & (enh_vesselness > np.mean(enh_vesselness)))
        total_vessels = np.sum(orig_vesselness > np.mean(orig_vesselness))
        sensitivity = preserved / total_vessels if total_vessels > 0 else 0
        specificity = 1.0  # Placeholder
    
    return {'Vessel_Sensitivity': float(sensitivity), 'Vessel_Specificity': float(specificity)}

def calculate_vessel_contrast_improvement(original, enhanced):
    """Calculate improvement in vessel-to-background contrast"""
    if original is None or enhanced is None:
        return 0.0
        
    orig_gray = cv2.cvtColor(original, cv2.COLOR_BGR2GRAY).astype(np.float32)
    enh_gray = cv2.cvtColor(enhanced, cv2.COLOR_BGR2GRAY).astype(np.float32)
    
    # Vessels are typically in mid-intensity range, background is darker/lighter
    vessel_mask = (orig_gray > 30) & (orig_gray < 120)
    background_mask = (orig_gray <= 20) | (orig_gray >= 200)
    
    if np.sum(vessel_mask) == 0 or np.sum(background_mask) == 0:
        return 0.0
    
    orig_contrast = np.mean(orig_gray[vessel_mask]) - np.mean(orig_gray[background_mask])
    enh_contrast = np.mean(enh_gray[vessel_mask]) - np.mean(enh_gray[background_mask])
    
    contrast_improvement = (enh_contrast - orig_contrast) / max(abs(orig_contrast), 1e-5)
    return float(contrast_improvement)

def calculate_noise_reduction_ratio(original, enhanced):
    """Calculate noise reduction while preserving edges"""
    if original is None or enhanced is None:
        return 1.0
        
    orig_gray = cv2.cvtColor(original, cv2.COLOR_BGR2GRAY).astype(np.float32)
    enh_gray = cv2.cvtColor(enhanced, cv2.COLOR_BGR2GRAY).astype(np.float32)
    
    # High-frequency content (noise + edges)
    orig_hf = cv2.Laplacian(orig_gray, cv2.CV_32F).var()
    enh_hf = cv2.Laplacian(enh_gray, cv2.CV_32F).var()
    
    noise_reduction = orig_hf / max(enh_hf, 1e-5)
    return float(noise_reduction)

def calculate_structural_preservation_index(original, enhanced):
    """Multi-scale structural preservation index"""
    if original is None or enhanced is None:
        return 0.0
        
    orig_gray = cv2.cvtColor(original, cv2.COLOR_BGR2GRAY)
    enh_gray = cv2.cvtColor(enhanced, cv2.COLOR_BGR2GRAY)
    
    scales = [1, 2, 4]  # Multi-scale analysis
    similarities = []
    
    for scale in scales:
        h, w = orig_gray.shape
        new_size = (w//scale, h//scale)
        
        orig_resized = cv2.resize(orig_gray, new_size)
        enh_resized = cv2.resize(enh_gray, new_size)
        
        scale_ssim = ssim(orig_resized, enh_resized, data_range=255)
        similarities.append(scale_ssim)
    
    return float(np.mean(similarities))

def _to_gray_uint8(img):
    if img is None:
        return np.zeros((100, 100), dtype=np.uint8)
    if img.ndim == 3 and img.shape[2] == 3:
        return cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    return img

def calculate_comprehensive_metrics(original, enhanced, domain='urban', vessel_gt=None):
    """Enhanced metrics calculation with domain-specific evaluations + vessel metrics + noise estimation"""
    if original is None or enhanced is None:
        return {'PSNR': 0.0, 'SSIM': 0.0, 'NIQE': 0.0, 'Estimated_Noise_Reduction': 0.0}
        
    # Basic metrics
    ref_g = _to_gray_uint8(original)
    tst_g = _to_gray_uint8(enhanced)
    
    try:
        psnr_val = psnr(ref_g, tst_g, data_range=255)
    except:
        psnr_val = 0.0
        
    try:
        ssim_val = ssim(ref_g, tst_g, data_range=255)
    except:
        ssim_val = 0.0
    
    # NIQE
    niqe_val = 0.0
    if NIQE_AVAILABLE:
        try:
            ten = torch.from_numpy(enhanced).permute(2,0,1).unsqueeze(0).float() / 255.0
            if torch.cuda.is_available():
                ten = ten.cuda()
            with torch.no_grad():
                niqe_val = float(_niqe(ten).item())
        except:
            niqe_val = 0.0
    
    # Novel: Estimated noise reduction via sigma
    orig_noise = estimate_image_noise(ref_g)
    enh_noise = estimate_image_noise(tst_g)
    noise_reduction = orig_noise / max(enh_noise, 1e-5)
    
    metrics = {
        'PSNR': float(psnr_val),
        'SSIM': float(ssim_val),
        'NIQE': float(niqe_val),
        'Estimated_Noise_Reduction': float(noise_reduction)
    }
    
    # Domain-specific metrics
    if domain == 'medical':
        metrics['Vessel_Contrast_Improvement'] = calculate_vessel_contrast_improvement(original, enhanced)
        metrics['Noise_Reduction_Ratio'] = calculate_noise_reduction_ratio(original, enhanced)
        metrics['Structural_Preservation_Index'] = calculate_structural_preservation_index(original, enhanced)
        vessel_metrics = calculate_vessel_metrics(ref_g, tst_g, vessel_gt)
        metrics.update(vessel_metrics)
    
    return metrics

