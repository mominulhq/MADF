# 2. NOVEL ENHANCEMENTS: Retinex-Inspired Preprocessing + Noise Estimation
# ================================
def estimate_image_noise(image_gray, method='wavelet'):
    """
    Novel: Noise estimation inspired by Noise-DA (ICLR 2025) for adaptive filtering
    - Uses wavelet-based sigma estimation for real-world noise levels
    """
    if method == 'wavelet':
        sigma = estimate_sigma(image_gray)
    else:
        # Simple Laplacian variance
        laplacian_var = cv2.Laplacian(image_gray, cv2.CV_64F).var()
        sigma = np.sqrt(laplacian_var / (image_gray.shape[0] * image_gray.shape[1]))
    return float(sigma)

def retinex_decomposition(image):
    """
    Novel: Simple Retinex-inspired decomposition for low-light enhancement (inspired by ILR-Net, PLOS ONE 2025)
    - Estimates illumination and reflectance for urban low-light
    """
    if image is None or image.size == 0:
        return image, np.ones_like(image)
    
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY).astype(np.float32) / 255.0
    # Simple log-based Retinex approximation
    log_img = np.log(gray + 1e-6)
    # Gaussian blur as illumination estimate
    illum = cv2.GaussianBlur(log_img, (15, 15), 0)
    reflectance = np.exp(log_img - illum)
    reflectance = np.clip(reflectance, 0, 1)
    # Enhance reflectance
    enhanced = image * (reflectance[:, :, np.newaxis] * 255.0 / np.mean(reflectance) * 255.0)
    return np.clip(enhanced, 0, 255).astype(np.uint8), reflectance * 255

def preprocess_image_enhanced(image, domain='urban', use_retinex=False):
    """
    Enhanced: Domain-aware preprocessing with optional Retinex (2025 advances in low-light)
    - CLAHE + Gamma for medical; Retinex for urban low-light
    """
    if image is None or image.size == 0:
        return image
    
    # Base CLAHE
    lab = cv2.cvtColor(image, cv2.COLOR_BGR2LAB)
    l, a, b = cv2.split(lab)
    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8,8))
    l = clahe.apply(l)
    lab = cv2.merge((l, a, b))
    enhanced = cv2.cvtColor(lab, cv2.COLOR_LAB2BGR)
    
    if use_retinex and domain == 'urban':
        enhanced, _ = retinex_decomposition(enhanced)
    
    if domain == 'medical':
        # Gamma for vessels
        gamma = 0.8
        enhanced = np.power(enhanced / 255.0, gamma) * 255.0
        enhanced = np.clip(enhanced, 0, 255).astype(np.uint8)
    
    return enhanced

