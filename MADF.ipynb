def visualize_domain_comparison(original, noisy, results_dict, domain, title_prefix="Sample", save_path=None):
    """Enhanced visualization with domain-specific analysis"""
    if original is None or noisy is None:
        print("Cannot visualize: original or noisy image is None")
        return
        
    methods = list(results_dict.keys())
    imgs = [original, noisy] + [results_dict[k] for k in methods]
    titles = ["Original", "Noisy"] + methods

    fig, axes = plt.subplots(2, 6, figsize=(24, 8))  # Increased for more methods
    axes = axes.flatten()
    
    for idx, (ax, im, title) in enumerate(zip(axes[:len(imgs)], imgs, titles)):
        if idx < len(imgs) and im is not None:
            ax.imshow(cv2.cvtColor(im, cv2.COLOR_BGR2RGB))
            ax.set_title(title, fontsize=8)
            ax.axis('off')
        else:
            ax.axis('off')
    
    # Add metrics comparison for extra subplots
    for ax in axes[len(imgs):]:
        ax.axis('off')
    
    if len(imgs) > 2:
        metrics_text = "Method Comparison:\n"
        for method in methods[:5]:  # Show more methods
            enhanced = results_dict[method]
            if enhanced is not None:
                metrics = calculate_comprehensive_metrics(original, enhanced, domain)
                metrics_text += f"\n{method}:\nPSNR: {metrics['PSNR']:.2f}\nSSIM: {metrics['SSIM']:.3f}\nENR: {metrics['Estimated_Noise_Reduction']:.2f}\n"
                if domain == 'medical':
                    metrics_text += f"VCI: {metrics.get('Vessel_Contrast_Improvement', 0):.3f}\nSens: {metrics.get('Vessel_Sensitivity', 0):.3f}"
        
        axes[-1].text(0.05, 0.5, metrics_text, transform=axes[-1].transAxes, 
                     fontsize=7, verticalalignment='center', bbox=dict(boxstyle="round,pad=0.3", facecolor="lightgray"))
    
    fig.suptitle(f"{title_prefix} - {domain.upper()} Domain", fontsize=14, y=0.95)
    plt.tight_layout()
    
    if save_path:
        fig.savefig(save_path, bbox_inches='tight', dpi=300)
    plt.show()

def show_residual_analysis(original, enhanced, method_name, save_path=None):
    """Enhanced residual analysis with quantitative measures"""
    if original is None or enhanced is None:
        print("Cannot show residual analysis: images are None")
        return
        
    residual = cv2.absdiff(original, enhanced)
    residual_normalized = cv2.normalize(residual, None, 0, 255, cv2.NORM_MINMAX)
    
    fig, (ax1, ax2, ax3) = plt.subplots(1, 3, figsize=(15, 5))
    
    # Original
    ax1.imshow(cv2.cvtColor(original, cv2.COLOR_BGR2RGB))
    ax1.set_title('Original')
    ax1.axis('off')
    
    # Enhanced
    ax2.imshow(cv2.cvtColor(enhanced, cv2.COLOR_BGR2RGB))
    ax2.set_title(f'({method_name})')
    ax2.axis('off')
    
    # Residual with statistics
    ax3.imshow(cv2.cvtColor(residual_normalized, cv2.COLOR_BGR2RGB))
    ax3.set_title(f'Residual Map\nMean: {np.mean(residual):.1f}, Std: {np.std(residual):.1f}')
    ax3.axis('off')
    
    plt.tight_layout()
    if save_path:
        plt.savefig(save_path, bbox_inches='tight', dpi=300)
    plt.show()

