def load_stare_dataset(stare_path, max_images=None):
    """
    NEW: Load STARE dataset for additional medical validation
    """
    if not os.path.exists(stare_path):
        print(f"STARE path does not exist: {stare_path}")
        return []
    
    # STARE images typically in all.tif or similar, but includes .ppm
    image_extensions = ('.tif', '.png', '.jpg', '.jpeg', '.ppm')
    selected = []
    for root, dirs, files in os.walk(stare_path):
        for file in files:
            if file.lower().endswith(image_extensions):
                img_path = os.path.join(root, file)
                try:
                    img = cv2.imread(img_path, cv2.IMREAD_COLOR)
                    if img is not None:
                        if img.shape[:2] != (512, 512):
                            img = cv2.resize(img, (512, 512), interpolation=cv2.INTER_CUBIC)
                        selected.append((img_path, img, 'STARE', "STARE", 'medical'))  # Added dataset_name, class_name
                        
                        if max_images and len(selected) >= max_images:
                            print(f"Loaded {len(selected)} images from STARE dataset")
                            return selected
                except Exception as e:
                    print(f"Error loading {img_path}: {e}")
    
    print(f"Loaded {len(selected)} images from STARE dataset")
    return selected

# Existing loaders...
def load_exdark_dataset(data_path, max_images=None, max_per_class=None):
    """Load ExDark with optional limits."""
    if not os.path.exists(data_path):
        print(f"ExDark path does not exist: {data_path}")
        return []
        
    class_images = {}
    for root, _, files in os.walk(data_path):
        class_name = os.path.basename(root)
        if class_name and class_name.lower() != os.path.basename(data_path).lower():
            imgs = [os.path.join(root, f) for f in files if f.lower().endswith(('.jpg', '.png', '.jpeg'))]
            if imgs:
                class_images[class_name] = imgs

    selected, total_images = [], 0
    for cname, imgs in class_images.items():
        chosen = imgs[:max_per_class] if max_per_class else imgs
        for f in chosen:
            if max_images and total_images >= max_images:
                return selected
            try:
                img = cv2.imread(f)
                if img is not None:
                    # Resize for consistency
                    if img.shape[:2] != (512, 512):
                        img = cv2.resize(img, (512, 512), interpolation=cv2.INTER_CUBIC)
                    selected.append((f, img, 'ExDark', cname, 'urban'))  # Added dataset_name, class_name
                    total_images += 1
            except Exception as e:
                print(f"Error loading {f}: {e}")
    return selected

def load_lol_dataset(train_path, test_path, max_images=None):
    """Load LOL-v2 dataset."""
    def list_imgs(p):
        if not os.path.isdir(p):
            return []
        files = glob.glob(os.path.join(p, "**", "*.png"), recursive=True) + \
                glob.glob(os.path.join(p, "**", "*.jpg"), recursive=True) + \
                glob.glob(os.path.join(p, "**", "*.jpeg"), recursive=True)
        return files

    all_imgs = list_imgs(train_path) + list_imgs(test_path)
    if max_images:
        all_imgs = all_imgs[:max_images]

    selected = []
    for f in all_imgs:
        try:
            img = cv2.imread(f)
            if img is not None:
                if img.shape[:2] != (512, 512):
                    img = cv2.resize(img, (512, 512), interpolation=cv2.INTER_CUBIC)
                selected.append((f, img, 'LOL-v2', "LOL", 'urban'))  # Added dataset_name, class_name
        except Exception as e:
            print(f"Error loading {f}: {e}")
    return selected

def load_drive_dataset_enhanced(drive_path, max_images=None):
    """
    Enhanced DRIVE dataset loader with multiple fallback options
    """
    if not os.path.exists(drive_path):
        print(f"DRIVE path does not exist: {drive_path}")
        return []
        
    possible_paths = [
        drive_path,
        os.path.join(drive_path, "images"),
        os.path.join(drive_path, "training", "images"),
        os.path.join(drive_path, "test", "images"),
        os.path.join(drive_path, "DRIVE", "images"),
    ]
    
    image_extensions = ('.tif', '.gif', '.png', '.jpg', '.jpeg', '.tiff')
    selected = []
    
    for test_path in possible_paths:
        if not os.path.exists(test_path):
            continue
            
        # Look for image files recursively
        for root, dirs, files in os.walk(test_path):
            for file in files:
                if file.lower().endswith(image_extensions):
                    img_path = os.path.join(root, file)
                    try:
                        img = cv2.imread(img_path)
                        if img is not None:
                            # Resize for consistency
                            if img.shape[:2] != (512, 512):
                                img = cv2.resize(img, (512, 512), interpolation=cv2.INTER_CUBIC)
