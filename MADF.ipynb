def run_ablation_study(noisy_dataset, ablation_dir):
    """Novel: Ablation on key components (preprocess, wavelet, retinex, fusion) for justification"""
    ablation_results = []
    components = [
        ("Base MDAF", lambda x: multi_domain_adaptive_filter_enhanced(x, use_preprocess=False, use_wavelet=False, use_retinex=False, use_freq_fusion=False)),
        ("+Preprocess", lambda x: multi_domain_adaptive_filter_enhanced(x, use_preprocess=True, use_wavelet=False, use_retinex=False, use_freq_fusion=False)),
        ("+Wavelet", lambda x: multi_domain_adaptive_filter_enhanced(x, use_preprocess=False, use_wavelet=True, use_retinex=False, use_freq_fusion=False)),
        ("+Retinex", lambda x: multi_domain_adaptive_filter_enhanced(x, use_preprocess=False, use_wavelet=False, use_retinex=True, use_freq_fusion=False)),
        ("+FreqFusion", lambda x: multi_domain_adaptive_filter_enhanced(x, use_preprocess=False, use_wavelet=False, use_retinex=False, use_freq_fusion=True)),
        ("Full MDAF++", lambda x: multi_domain_adaptive_filter_enhanced(x, use_preprocess=True, use_wavelet=True, use_retinex=True, use_freq_fusion=True)),
    ]
    
    for i, (path, orig, noisy, dataset_name, class_name, domain) in enumerate(tqdm(noisy_dataset[:15], desc="Ablation")):  # More samples
        for comp_name, func in components:
            metrics = calculate_comprehensive_metrics(orig, func(noisy.copy()), domain)
            metrics.update({"Component": comp_name, "Image": os.path.basename(path), "Dataset": dataset_name, "Domain": domain})
            ablation_results.append(metrics)
    
    ab_df = pd.DataFrame(ablation_results)
    ab_df.to_csv(ablation_dir / "ablation_results.csv", index=False)
    
    # Save per-dataset ablation results
    if 'Dataset' in ab_df.columns:
        for ds in ab_df['Dataset'].unique():
            ds_ab_df = ab_df[ab_df['Dataset'] == ds]
            if not ds_ab_df.empty:
                ds_ab_df.to_csv(ablation_dir / f"ablation_results_{ds}.csv", index=False)
    
    # Plot ablation for multiple metrics
    fig, axes = plt.subplots(1, 3, figsize=(18, 5))
    for idx, metric in enumerate(['PSNR', 'SSIM', 'Estimated_Noise_Reduction']):
        means = ab_df.groupby('Component')[metric].mean()
        means.plot(kind='bar', ax=axes[idx])
        axes[idx].set_title(f'Ablation: {metric}')
        axes[idx].tick_params(axis='x', rotation=45)
    plt.tight_layout()
    plt.savefig(ablation_dir / "ablation_plot.png", dpi=300)
    plt.show()
    
    print("Ablation study completed and saved.")

