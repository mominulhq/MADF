# 3. NOVEL: MDAF++ with Noise-Space Adaptation and Multi-Scale Frequency Fusion
# ================================
def detect_image_domain(image):
    """Auto-detect domain: medical (retinal) vs urban"""
    if image is None or image.size == 0:
        return 'urban'
    
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    
    # Medical images have circular FOV and specific intensity distribution
    h, w = gray.shape
    center_y, center_x = h // 2, w // 2
    radius = min(center_x, center_y) * 0.9
    
    # Create circular mask
    y, x = np.ogrid[:h, :w]
    mask = (x - center_x)**2 + (y - center_y)**2 <= radius**2
    circular_pixels = gray[mask]
    
    if len(circular_pixels) > 0:
        circularity = np.std(circular_pixels) / (np.mean(circular_pixels) + 1e-5)
        intensity_median = np.median(circular_pixels)
        
        # Medical images typically have dark circular regions with specific intensity
        if circularity > 0.5 and 20 < intensity_median < 120:
            return 'medical'
    return 'urban'

def vessel_enhancement_frangi(gray_image, scale_range=(1, 10), scale_step=2):
    """
    Novel: Frangi vesselness filter for retinal vessel preservation (inspired by WaveNet-SF, Neural Networks 2025)
    """
    if gray_image is None:
        return gray_image
    sigmas = np.arange(scale_range[0], scale_range[1], scale_step)
    vesselness = frangi(gray_image / 255.0, sigmas=sigmas)
    # Blend with original for enhancement
    enhanced = gray_image + 0.5 * vesselness * 255  # Scale vesselness to [0,255]
    return np.clip(enhanced, 0, 255).astype(np.uint8)

def multi_scale_frequency_fusion(patch, levels=3):
    """
    Novel: Multi-scale spatial-frequency fusion via wavelet (inspired by multi-scale features, Pattern Recognition 2025)
    - Decompose, denoise, reconstruct with frequency weighting
    """
    coeffs = pywt.wavedec2(patch.astype(np.float32), 'db4', level=levels)
    # Adaptive thresholding per scale
    for lvl in range(len(coeffs)):
        if isinstance(coeffs[lvl], tuple):
            coeffs[lvl] = tuple(pywt.threshold(c, 0.3 * np.std(c), mode='soft') for c in coeffs[lvl])
        else:
            coeffs[lvl] = pywt.threshold(coeffs[lvl], 0.3 * np.std(coeffs[lvl]), mode='soft')
    fused = pywt.waverec2(coeffs, 'db4')
    return np.clip(fused, 0, 255).astype(np.uint8)

def medical_optimized_amgf_enhanced(image, min_kernel=3, max_kernel=15, use_wavelet=False, use_freq_fusion=False):
    """Enhanced Medical AMGF with vessel preservation, wavelet, and frequency fusion"""
    if image is None or image.size == 0:
        return image
    
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    h, w = gray.shape
    output = np.zeros_like(image, dtype=np.float32)

    # Medical-optimized parameters
    PATCH = 8  # Smaller patches for fine details
    VESSEL_RANGE = (25, 90)  # Typical vessel intensity range
    
    # Novel: Pre-enhance vessels using Frangi
    gray_enhanced = vessel_enhancement_frangi(gray)
    
    # Noise estimation for adaptive params
    noise_sigma = estimate_image_noise(gray_enhanced)
    adaptive_kernel_max = min(max_kernel, int(15 + noise_sigma / 5))  # Scale with noise
    
    # Enhanced edge detection for vessels
    sobel_x = cv2.Sobel(gray_enhanced, cv2.CV_64F, 1, 0, ksize=3)
    sobel_y = cv2.Sobel(gray_enhanced, cv2.CV_64F, 0, 1, ksize=3)
    edge_magnitude = np.sqrt(sobel_x**2 + sobel_y**2)

    for y in range(0, h, PATCH):
        for x in range(0, w, PATCH):
            y2, x2 = min(y + PATCH, h), min(x + PATCH, w)
            patch_gray = gray_enhanced[y:y2, x:x2]
            if patch_gray.size == 0:
                continue
                
            brightness = float(np.mean(patch_gray))
            patch_edges = edge_magnitude[y:y2, x:x2]
            
            # Vessel-aware kernel selection, noise-adaptive
            vessel_likelihood = np.mean((patch_gray >= VESSEL_RANGE[0]) & (patch_gray <= VESSEL_RANGE[1]))
            noise_factor = min(1.0, noise_sigma / 30.0)  # Normalize noise
            
            if vessel_likelihood > 0.3:  # High vessel probability
                kernel_size = max(3, int(3 * (1 - noise_factor)))
            else:
                # Adaptive smoothing based on brightness and noise
                kernel_size = max(min_kernel, min(adaptive_kernel_max, 
                                int((1 - brightness / 255.0) * adaptive_kernel_max * (1 + noise_factor))))
            
            if kernel_size % 2 == 0:
                kernel_size += 1

            for c in range(3):
                patch_orig = image[y:y2, x:x2, c]
                if use_freq_fusion:
                    filtered_patch = multi_scale_frequency_fusion(patch_orig)
                elif use_wavelet:
                    # Wavelet denoising integration (inspired by OCT wavelet, Opt. Eng. 2025)
                    coeffs = pywt.wavedec2(patch_orig.astype(np.float32), 'db1', level=2)
                    # Threshold approximation mildly
                    approx = pywt.threshold(coeffs[0], 0.1 * np.std(coeffs[0]) * noise_factor, mode='soft')
                    # Threshold details more aggressively
                    details = [tuple(pywt.threshold(cc, 0.5 * np.std(cc) * noise_factor, mode='soft') for cc in detail_tuple) 
                               for detail_tuple in coeffs[1:]]
                    denoised_coeffs = [approx] + details
                    filtered_patch = pywt.waverec2(denoised_coeffs, 'db1')
                    filtered_patch = np.clip(filtered_patch, 0, 255)
                else:
                    filtered_patch = gaussian_filter(
                        patch_orig,
                        sigma=kernel_size / 6.0,
                        truncate=kernel_size / 3.0
                    )
                
                # Vessel-preserving blending, noise-aware
                edge_weight = np.minimum(1.0, (patch_edges / 255.0) * (255.0 / max(brightness, 1e-5)) * (1 - noise_factor))
                
                # Boost edge preservation in vessel-like regions
                if vessel_likelihood > 0.2:
                    edge_weight = np.minimum(1.0, edge_weight * (1 + vessel_likelihood))
                
                orig_patch = patch_orig.astype(np.float32)
                output[y:y2, x:x2, c] = filtered_patch * (1.0 - edge_weight) + orig_patch * edge_weight

    return np.clip(output, 0, 255).astype(np.uint8)

def adaptive_multi_scale_gaussian_with_bwep_enhanced(image, min_kernel=3, max_kernel=15, step=2, ablation=False, use_wavelet=False, use_freq_fusion=False):
    """Enhanced AMGF with optional wavelet/fusion for urban low-light"""
    if image is None or image.size == 0:
        raise ValueError("Input image is empty or None.")
        
    if image.ndim != 3 or image.shape[2] != 3:
        raise ValueError("Input must be a color image with 3 channels (BGR).")

    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    h, w = gray.shape
    output = np.zeros_like(image, dtype=np.float32)

    # Noise estimation
    noise_sigma = estimate_image_noise(gray)
    adaptive_kernel_max = min(max_kernel, int(15 + noise_sigma / 5))

    sobel_x = cv2.Sobel(gray, cv2.CV_64F, 1, 0, ksize=3)
    sobel_y = cv2.Sobel(gray, cv2.CV_64F, 0, 1, ksize=3)
    edge_magnitude = np.sqrt(sobel_x**2 + sobel_y**2)

    PATCH = 10
    for y in range(0, h, PATCH):
        for x in range(0, w, PATCH):
            y2, x2 = min(y + PATCH, h), min(x + PATCH, w)
            patch = gray[y:y2, x:x2]
            if patch.size == 0:
                continue
            brightness = float(np.mean(patch))
            noise_factor = min(1.0, noise_sigma / 30.0)
            kernel_size = max(min_kernel, min(adaptive_kernel_max, int((1 - brightness / 255.0) * adaptive_kernel_max * (1 + noise_factor))))
            if kernel_size % 2 == 0:
                kernel_size += 1

            for c in range(3):
                patch_orig = image[y:y2, x:x2, c]
                if use_freq_fusion:
                    filtered_patch = multi_scale_frequency_fusion(patch_orig)
                elif use_wavelet:
                    # Wavelet denoising
                    coeffs = pywt.wavedec2(patch_orig.astype(np.float32), 'db1', level=2)
                    # Threshold approximation mildly
                    approx = pywt.threshold(coeffs[0], 0.1 * np.std(coeffs[0]) * noise_factor, mode='soft')
                    # Threshold details more aggressively
                    details = [tuple(pywt.threshold(cc, 0.5 * np.std(cc) * noise_factor, mode='soft') for cc in detail_tuple) 
                               for detail_tuple in coeffs[1:]]
                    denoised_coeffs = [approx] + details
                    filtered_patch = pywt.waverec2(denoised_coeffs, 'db1')
                    filtered_patch = np.clip(filtered_patch, 0, 255)
                else:
                    filtered_patch = gaussian_filter(
                        patch_orig,
                        sigma=kernel_size / 6.0,
                        truncate=kernel_size / 3.0
                    )
                if ablation:
                    output[y:y2, x:x2, c] = filtered_patch
                else:
                    denom = max(brightness, 1e-5)
                    edge_weight = np.minimum(1.0, (edge_magnitude[y:y2, x:x2] / 255.0) * (255.0 / denom) * (1 - noise_factor))
                    edge_weight = np.clip(edge_weight, 0.0, 1.0).astype(np.float32)
                    orig_patch = patch_orig.astype(np.float32)
                    output[y:y2, x:x2, c] = filtered_patch * (1.0 - edge_weight) + orig_patch * edge_weight

    return np.clip(output, 0, 255).astype(np.uint8)

def multi_domain_adaptive_filter_enhanced(image, min_kernel=3, max_kernel=15, domain_type='auto', use_wavelet=False, use_preprocess=True, use_retinex=False, use_freq_fusion=False):
    """
    NOVEL ENHANCED MDAF++: With noise-space adaptation (Noise-DA, ICLR 2025), Retinex (ILR-Net 2025), multi-scale fusion (PR 2025)
    - Real-world impact: Adaptive to varying noise in telemedicine/OCT and urban surveillance
    """
    if image is None or image.size == 0:
        return image
    
    if use_preprocess:
        image = preprocess_image_enhanced(image, domain_type, use_retinex)
    
    if domain_type == 'auto':
        domain_type = detect_image_domain(image)
    
    if domain_type == 'medical':
        return medical_optimized_amgf_enhanced(image, min_kernel, max_kernel, use_wavelet, use_freq_fusion)
    else:
        # Use enhanced AMGF for urban images
        return adaptive_multi_scale_gaussian_with_bwep_enhanced(image, min_kernel, max_kernel, ablation=False, use_wavelet=use_wavelet, use_freq_fusion=use_freq_fusion)

