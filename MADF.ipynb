def save_per_dataset_results(df, rt, output_dir):
    """Save separate CSV files and summaries for each dataset"""
    if len(df) == 0:
        print("No data available for per-dataset saving")
        return
    
    datasets = df['Dataset'].unique() if 'Dataset' in df.columns else ['all']
    
    for dataset_name in datasets:
        if dataset_name == 'all':
            dataset_df = df
            dataset_rt = rt
        else:
            dataset_df = df[df['Dataset'] == dataset_name]
            dataset_rt = rt[rt['Dataset'] == dataset_name] if 'Dataset' in rt.columns else rt
        
        if len(dataset_df) > 0:
            # Save main metrics
            dataset_df.to_csv(output_dir / f"comprehensive_metrics_{dataset_name}.csv", index=False)
            
            # Save runtime data
            if len(dataset_rt) > 0:
                dataset_rt.to_csv(output_dir / f"runtimes_ms_{dataset_name}.csv", index=False)
            
            # Create detailed summary statistics for each dataset
            summary_stats = dataset_df.groupby('Method').agg({
                'PSNR': ['mean', 'std', 'min', 'max'],
                'SSIM': ['mean', 'std', 'min', 'max'],
                'NIQE': ['mean', 'std', 'min', 'max'],
                'Estimated_Noise_Reduction': ['mean', 'std', 'min', 'max']
            }).round(4)
            
            # Flatten column names
            summary_stats.columns = ['_'.join(col).strip() for col in summary_stats.columns.values]
            summary_stats.reset_index(inplace=True)
            summary_stats.to_csv(output_dir / f"summary_{dataset_name}.csv", index=False)
            
            # Create performance ranking
            performance_ranking = dataset_df.groupby('Method').agg({
                'PSNR': 'mean',
                'SSIM': 'mean',
                'Estimated_Noise_Reduction': 'mean'
            }).round(4)
            
            # Add ranks
            performance_ranking['PSNR_Rank'] = performance_ranking['PSNR'].rank(ascending=False)
            performance_ranking['SSIM_Rank'] = performance_ranking['SSIM'].rank(ascending=False)
            performance_ranking['ENR_Rank'] = performance_ranking['Estimated_Noise_Reduction'].rank(ascending=False)
            performance_ranking['Overall_Rank'] = (performance_ranking['PSNR_Rank'] + 
                                                 performance_ranking['SSIM_Rank'] + 
                                                 performance_ranking['ENR_Rank']) / 3
            
            performance_ranking = performance_ranking.sort_values('Overall_Rank')
            performance_ranking.to_csv(output_dir / f"performance_ranking_{dataset_name}.csv")
            
            print(f"✅ Saved {dataset_name} dataset: {len(dataset_df)} records, {len(dataset_rt)} runtime records")
        else:
            print(f"⚠️  No data found for dataset: {dataset_name}")

