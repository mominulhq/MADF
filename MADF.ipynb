def retinex_nlm_hybrid(image):
    """Novel Hybrid: Retinex decomposition + NLM for low-light denoising"""
    if image is None or image.size == 0:
        return image
    
    enhanced, reflectance = retinex_decomposition(image)
    # NLM on reflectance-enhanced
    denoised = cv2.fastNlMeansDenoisingColored(enhanced, None, 10, 10, 7, 21)
    return denoised

