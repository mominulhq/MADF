def create_journal_quality_plots(df, rt):
    """Create publication-ready figures, including ablation"""
    if len(df) == 0:
        print("No data available for plotting")
        return
    
    # 1. Overall performance comparison
    plt.figure(figsize=(12, 8))
    
    # PSNR comparison
    plt.subplot(2, 2, 1)
    psnr_means = df.groupby('Method')['PSNR'].mean().sort_values(ascending=False)
    psnr_means.plot(kind='bar')
    plt.xticks(rotation=45, ha='right')
    plt.ylabel('PSNR (dB)')
    plt.title('Average PSNR by Method')
    plt.grid(True, alpha=0.3)
    
    # SSIM comparison
    plt.subplot(2, 2, 2)
    ssim_means = df.groupby('Method')['SSIM'].mean().sort_values(ascending=False)
    ssim_means.plot(kind='bar')
    plt.xticks(rotation=45, ha='right')
    plt.ylabel('SSIM')
    plt.title('Average SSIM by Method')
    plt.grid(True, alpha=0.3)
    
    # Runtime comparison
    plt.subplot(2, 2, 3)
    if len(rt) > 0:
        runtime_cols = [col for col in rt.columns if col not in ['Image', 'Dataset', 'Class', 'Domain']]
        if runtime_cols:
            runtime_means = rt[runtime_cols].mean().sort_values(ascending=False)
            runtime_means.plot(kind='bar')
            plt.ylabel('Runtime (ms)')
            plt.title('Average Runtime by Method')
            plt.xticks(rotation=45, ha='right')
            plt.grid(True, alpha=0.3)
    
    # Domain-wise performance + Vessel Sens for medical + Noise Reduction
    plt.subplot(2, 2, 4)
    if 'Domain' in df.columns:
        if 'Vessel_Sensitivity' in df.columns and 'medical' in df['Domain'].values:
            med_df = df[df['Domain'] == 'medical']
            sens_means = med_df.groupby('Method')['Vessel_Sensitivity'].mean().sort_values(ascending=False)
            sens_means.plot(kind='bar', ax=plt.gca())
            plt.ylabel('Vessel Sensitivity')
            plt.title('Medical: Vessel Sensitivity by Method')
        elif 'Estimated_Noise_Reduction' in df.columns:
            enr_means = df.groupby('Method')['Estimated_Noise_Reduction'].mean().sort_values(ascending=False)
            enr_means.plot(kind='bar', ax=plt.gca())
            plt.ylabel('Est. Noise Reduction')
            plt.title('Overall: Estimated Noise Reduction')
        else:
            domain_psnr = df.groupby(['Domain', 'Method'])['PSNR'].mean().unstack()
            if domain_psnr.shape[1] > 0:
                domain_psnr.T.plot(kind='bar', ax=plt.gca())
                plt.ylabel('Average PSNR (dB)')
                plt.title('Domain-wise PSNR Performance')
        plt.xticks(rotation=45, ha='right')
        plt.legend(title='Domain' if 'Vessel_Sensitivity' not in df.columns and 'Estimated_Noise_Reduction' not in df.columns else None)
        plt.grid(True, alpha=0.3)
    
    plt.tight_layout()
    plt.savefig(OUT_DIR / "figs" / "journal_comprehensive_analysis.png", dpi=600, bbox_inches='tight')
    plt.show()
    
    # 2. Statistical significance plot per domain
    if stats_results:
        for dom in ['urban', 'medical', 'all']:
            dom_stats = {k: v for k, v in stats_results.items() if k.startswith(dom + '_')}
            if dom_stats:
                plt.figure(figsize=(10, 6))
                effect_sizes = {}
                for key, result in dom_stats.items():
                    if 'cohen_d' in result and 'MDAF' in key:
                        method = key.split('_vs_')[1].split('_')[0]
                        metric = key.split('_')[-1]
                        if method not in effect_sizes:
                            effect_sizes[method] = {}
                        effect_sizes[method][metric] = result['cohen_d']
                
                if effect_sizes:
                    effect_df = pd.DataFrame(effect_sizes).T
                    effect_df.plot(kind='bar', ax=plt.gca())
                    plt.ylabel("Cohen's d Effect Size")
                    plt.title(f"{dom.upper()}: Effect Size of MDAF++ vs Baselines")
                    plt.axhline(y=0.2, color='red', linestyle='--', alpha=0.7, label='Small effect (0.2)')
                    plt.axhline(y=0.5, color='orange', linestyle='--', alpha=0.7, label='Medium effect (0.5)')
                    plt.axhline(y=0.8, color='green', linestyle='--', alpha=0.7, label='Large effect (0.8)')
                    plt.legend()
                    plt.grid(True, alpha=0.3)
                    plt.xticks(rotation=45)
                    plt.tight_layout()
                    plt.savefig(OUT_DIR / "figs" / f"{dom}_effect_size_analysis.png", dpi=600, bbox_inches='tight')
                    plt.show()

