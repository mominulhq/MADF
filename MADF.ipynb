        print("No data available for statistical analysis")
        return analysis_results
        
    print("Available methods in dataset:", df['Method'].unique())
    print("Available domains in dataset:", df['Domain'].unique() if 'Domain' in df.columns else "No domain column")
    
    domains = df['Domain'].unique() if 'Domain' in df.columns else ['all']
    
    for dom in domains:
        dom_df = df[df['Domain'] == dom] if dom != 'all' else df
        print(f"\n--- Analysis for {dom} ---")
        
        # 1. ANOVA for overall method differences
        for metric in ['PSNR', 'SSIM', 'NIQE', 'Estimated_Noise_Reduction']:
            try:
                # Filter out methods with insufficient data
                method_groups = []
                method_names = []
                for method_name, group in dom_df.groupby('Method'):
                    if len(group) >= 3:  # Minimum for ANOVA
                        method_groups.append(group[metric].values)
                        method_names.append(method_name)
                
                if len(method_groups) >= 2:
                    f_stat, p_value = stats.f_oneway(*method_groups)
                    analysis_results[f'{dom}_{metric}_ANOVA'] = {
                        'F': f_stat, 
                        'p_value': p_value, 
                        'significant': p_value < 0.05,
                        'methods_tested': len(method_groups)
                    }
                    print(f"ANOVA for {metric}: F={f_stat:.3f}, p={p_value:.4f}")
                else:
                    print(f"Not enough methods with data for {metric} ANOVA")
                    
            except Exception as e:
                print(f"ANOVA failed for {metric}: {e}")
        
        # 2. Pairwise for proposed vs baselines, per domain
        proposed_method = 'MDAF++ (Proposed)'
        baseline_methods = ['Median', 'Gaussian', 'Bilateral', 'AMGF+BWEP', 'Kalman-NLM Hybrid', 'Retinex-NLM Hybrid']
        
        for baseline in baseline_methods:
            for metric in ['PSNR', 'SSIM', 'Estimated_Noise_Reduction']:
                try:
                    # Get data for both methods
                    proposed_data = dom_df[dom_df['Method'] == proposed_method][metric].dropna()
                    baseline_data = dom_df[dom_df['Method'] == baseline][metric].dropna()
                    
                    if len(proposed_data) > 1 and len(baseline_data) > 1:
                        # Use independent t-test
                        t_stat, p_value = stats.ttest_ind(proposed_data, baseline_data, equal_var=False)
                        
                        # Effect size (Cohen's d)
                        n1, n2 = len(proposed_data), len(baseline_data)
                        pooled_std = np.sqrt(((n1-1)*np.std(proposed_data)**2 + (n2-1)*np.std(baseline_data)**2) / (n1 + n2 - 2))
                        cohen_d = (np.mean(proposed_data) - np.mean(baseline_data)) / pooled_std
                        
                        analysis_results[f'{dom}_{proposed_method}_vs_{baseline}_{metric}'] = {
                            't_statistic': t_stat,
                            'p_value': p_value,
                            'cohen_d': cohen_d,
                            'significant': p_value < 0.05,
                            'improvement': np.mean(proposed_data) - np.mean(baseline_data),
                            'proposed_mean': np.mean(proposed_data),
                            'baseline_mean': np.mean(baseline_data),
                            'n_proposed': n1,
                            'n_baseline': n2
                        }
                        
                except Exception as e:
                    print(f"Comparison {proposed_method} vs {baseline} for {metric} failed: {e}")
    
    return analysis_results

def print_enhanced_statistical_results(stats_results):
    """Professional formatting for statistical results, per domain"""
    print("\n" + "="*80)
    print("ENHANCED PER-DOMAIN STATISTICAL SIGNIFICANCE ANALYSIS")
    print("="*80)
    
    if not stats_results:
        print("No statistical results available")
        return
    
    # Group by domain
    domains = set(k.split('_')[0] for k in stats_results if '_' in k)
    for dom in sorted(domains):
        print(f"\n--- {dom.upper()} DOMAIN ---")
        dom_results = {k: v for k, v in stats_results.items() if k.startswith(dom + '_')}
        
        anova_results = {k: v for k, v in dom_results.items() if 'ANOVA' in k}
        pairwise_results = {k: v for k, v in dom_results.items() if 'ANOVA' not in k}
        
        # Print ANOVA results
        if anova_results:
            print("\n📊 OVERALL METHOD DIFFERENCES (ANOVA):")
            print("-" * 60)
            for key, result in anova_results.items():
                metric = key.replace(f'{dom}_', '').replace('_ANOVA', '')
                p_val = result['p_value']
                sig_symbol = "***" if p_val < 0.001 else "**" if p_val < 0.01 else "*" if p_val < 0.05 else "ns"
                print(f"{metric}: F({result.get('methods_tested', 'N/A')}) = {result['F']:.3f}, p = {p_val:.6f} {sig_symbol}")
        
        # Print pairwise comparisons
        if pairwise_results:
            print("\n🔍 PAIRWISE COMPARISONS (MDAF++ vs Baselines):")
            print("-" * 80)
            print(f"{'Comparison':<30} {'t-stat':<8} {'p-value':<10} {'Cohen’s d':<10} {'Improvement':<12} {'Status':<10}")
            print("-" * 80)
            
            for key, result in pairwise_results.items():
                if 'ANOVA' in key:
                    continue
                p_val = result['p_value']
                sig_symbol = "***" if p_val < 0.001 else "**" if p_val < 0.01 else "*" if p_val < 0.05 else "ns"
                status = "SIGNIFICANT" if result['significant'] else "not significant"
                
                # Extract
                parts = key.replace(f'{dom}_', '').split('_vs_')
                method1 = parts[0]
                method2_metric = parts[1]
                method2 = method2_metric.rsplit('_', 1)[0]
                metric = method2_metric.rsplit('_', 1)[1]
                
                comparison = f"{method1} vs {method2} ({metric})"
                
                print(f"{comparison:<30} {result['t_statistic']:>7.2f} {p_val:>9.4f} {result['cohen_d']:>9.3f} "
                      f"{result['improvement']:>11.3f} {status:>10} {sig_symbol}")

