# 7. Enhanced Noise Simulation (Add Real-World Noise Levels)
# ================================
def add_gaussian_noise(image, sigma=25):
    if image is None or image.size == 0:
        return image
    noise = np.random.normal(0, sigma, image.shape).astype(np.float32)
    noisy = image.astype(np.float32) + noise
    return np.clip(noisy, 0, 255).astype(np.uint8)

def add_poisson_noise(image):
    """Add Poisson noise for medical imaging simulation"""
    if image is None or image.size == 0:
        return image
    image_float = image.astype(np.float32) / 255.0
    noisy = np.random.poisson(image_float * 255) / 255.0
    return np.clip(noisy * 255, 0, 255).astype(np.uint8)

USE_NOISE = True
NOISE_SIGMA = 25  # Can vary for ablation
USE_MEDICAL_NOISE = True  # Use Poisson noise for medical images

noisy_dataset = []
for path, img, dataset_name, class_name, domain in dataset:
    if USE_NOISE:
        if domain == 'medical' and USE_MEDICAL_NOISE:
            noisy = add_poisson_noise(img)
        else:
            noisy = add_gaussian_noise(img, sigma=NOISE_SIGMA)
    else:
        noisy = img.copy()
    noisy_dataset.append((path, img, noisy, dataset_name, class_name, domain))

